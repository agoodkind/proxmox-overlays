#!/usr/bin/perl

# Applies the patches in this repository to the packaged Proxmox VE modules
# and writes the results to /etc/perl. Debian Perl searches /etc/perl before
# /usr/share/perl5, also in taint mode, and every Proxmox program then loads
# the patched copies.

use strict;
use warnings;

use Cwd qw(abs_path);
use File::Basename qw(dirname);
use File::Path qw(make_path);
use Getopt::Long qw(GetOptions);

# The repository has the patches in a directory beside the script. A host has
# them as flat files in a directory that Debian creates, because the OpenTofu
# file resource writes a file only into an existing directory.
my @PATCH_GLOBS = (
    dirname(abs_path($0)) . '/patches/*.patch',
    '/usr/local/share/pve-overlay-*.patch',
);
my $PACKAGED_MODULE_DIR = '/usr/share/perl5';
my $DEFAULT_TARGET_DIR = '/etc/perl';
my $DPKG_HOOK_FILE = '/etc/dpkg/dpkg.cfg.d/pve-overlay';

# A patch adds a host file as overlay-root/<path>, and pve-overlay installs it
# at /<path>. Only a path below one of these directories is installed.
my @HOST_FILE_DIRS = qw(etc/apparmor.d/);
my $APPARMOR_DIR = 'etc/apparmor.d/';

# Units that load the patched modules at start.
my @UNITS = qw(pvedaemon pveproxy pvestatd pvescheduler pve-ha-lrm);

my $source_root = '';
my $target_dir = $DEFAULT_TARGET_DIR;
my $host_root = '';
my $hook_mode = 0;
my $system_mode = 1;

sub read_file {
    my ($path) = @_;
    open(my $handle, '<', $path) or die "cannot read $path: $!\n";
    local $/ = undef;
    my $content = <$handle>;
    close($handle);
    return $content;
}

sub write_file {
    my ($path, $content) = @_;
    make_path(dirname($path));
    my $temporary_path = "$path.new";
    open(my $handle, '>', $temporary_path) or die "cannot write $temporary_path: $!\n";
    print {$handle} $content;
    close($handle) or die "cannot write $temporary_path: $!\n";
    rename($temporary_path, $path) or die "cannot rename $temporary_path: $!\n";
}

sub host_file_dir_allows {
    my ($relative_path) = @_;
    return 0 if $relative_path =~ m{(?:^|/)\.\.(?:/|\z)};
    return scalar(grep { index($relative_path, $_) == 0 } @HOST_FILE_DIRS);
}

# Returns one entry per installed file. A module entry has the path below the
# module directory. A host file entry has the path below /. Each patch file is
# the commit of one fork. Other files, such as tests, are skipped.
sub read_file_diffs {
    my @patch_paths;
    for my $patch_glob (@PATCH_GLOBS) {
        @patch_paths = sort glob($patch_glob);
        last if @patch_paths;
    }

    my @entries;
    for my $patch_path (@patch_paths) {
        for my $file_diff (split(/^(?=diff --git )/m, read_file($patch_path))) {
            my $is_new = $file_diff =~ /^new file mode /m ? 1 : 0;
            if ($file_diff =~ m{^diff --git a/(?:src/)?(PVE/\S+\.pm) b/}) {
                push @entries, {
                    kind => 'module',
                    relative_path => $1,
                    source_path => "$source_root$PACKAGED_MODULE_DIR/$1",
                    target_path => "$target_dir/$1",
                    diff => $file_diff,
                    is_new => $is_new,
                };
            } elsif ($file_diff =~ m{^diff --git a/(?:src/)?overlay-root/(\S+) b/}) {
                my $relative_path = $1;
                die "pve-overlay: $patch_path adds $relative_path outside @HOST_FILE_DIRS\n"
                    if !host_file_dir_allows($relative_path);
                die "pve-overlay: $patch_path changes $relative_path, and a host file must be new\n"
                    if !$is_new;
                push @entries, {
                    kind => 'host',
                    relative_path => $relative_path,
                    source_path => undef,
                    target_path => "$host_root/$relative_path",
                    diff => $file_diff,
                    is_new => 1,
                };
            }
        }
    }
    die "pve-overlay: no module patches match @PATCH_GLOBS\n"
        if !grep { $_->{kind} eq 'module' } @entries;
    return @entries;
}

sub block_matches_at {
    my ($lines, $block, $index) = @_;
    return 0 if $index < 0 || $index + scalar(@$block) > scalar(@$lines);
    for my $offset (0 .. $#$block) {
        return 0 if $lines->[$index + $offset] ne $block->[$offset];
    }
    return 1;
}

# Finds the old lines of a hunk. The position from the hunk header wins. A
# moved block is accepted only when exactly one position matches.
sub find_block {
    my ($lines, $block, $expected_index) = @_;
    return $expected_index if block_matches_at($lines, $block, $expected_index);
    my @matches = grep { block_matches_at($lines, $block, $_) } 0 .. scalar(@$lines);
    return scalar(@matches) == 1 ? $matches[0] : undef;
}

# Parses the hunks of one file diff. The line counts in each hunk header
# bound the hunk, and text after the last hunk is ignored.
sub parse_hunks {
    my ($diff) = @_;
    my @hunks;
    my ($old_remaining, $new_remaining) = (0, 0);
    for my $line (split(/\n/, $diff)) {
        if ($old_remaining == 0 && $new_remaining == 0) {
            next if $line !~ /^@@ -(\d+)(?:,(\d+))? \+\d+(?:,(\d+))? @@/;
            ($old_remaining, $new_remaining) = ($2 // 1, $3 // 1);
            push @hunks, { start => $1, old => [], new => [] };
            next;
        }
        next if $line =~ /^\\/;
        # Some tools strip the single space of an empty context line.
        $line = ' ' if $line eq '';
        my ($kind, $text) = (substr($line, 0, 1), substr($line, 1));
        if ($kind eq ' ' || $kind eq '-') {
            push @{ $hunks[-1]{old} }, $text;
            $old_remaining--;
        }
        if ($kind eq ' ' || $kind eq '+') {
            push @{ $hunks[-1]{new} }, $text;
            $new_remaining--;
        }
    }
    return @hunks;
}

# Applies one file diff to the text of that file. Every context line and
# every removed line must match exactly.
sub apply_diff {
    my ($original, $diff, $label) = @_;

    my @lines = split(/\n/, $original, -1);
    my @hunks = parse_hunks($diff);
    die "$label: the patch has no hunks\n" if !@hunks;

    my $line_shift = 0;
    for my $hunk (@hunks) {
        my $index = find_block(\@lines, $hunk->{old}, $hunk->{start} - 1 + $line_shift);
        die "$label: the hunk at line $hunk->{start} does not apply\n" if !defined($index);
        splice(@lines, $index, scalar(@{ $hunk->{old} }), @{ $hunk->{new} });
        $line_shift += scalar(@{ $hunk->{new} }) - scalar(@{ $hunk->{old} });
    }
    return join("\n", @lines);
}

# Returns the text of a file that a patch adds. The hunk of a new file has
# no old lines, and its new lines are the whole file.
sub new_file_text {
    my ($diff, $label) = @_;
    my @hunks = parse_hunks($diff);
    die "$label: the patch of a new file needs exactly one hunk\n" if scalar(@hunks) != 1;
    die "$label: the patch of a new file has old lines\n" if @{ $hunks[0]{old} };
    return join("\n", @{ $hunks[0]{new} }) . "\n";
}

# Returns the text of every installed file, keyed by target path.
sub build_patched_files {
    my %patched;
    for my $entry (read_file_diffs()) {
        my $relative_path = $entry->{relative_path};
        if ($entry->{is_new}) {
            # A package that starts to ship this module is drift. apply then
            # removes the copies, and Proxmox loads the packaged module.
            die "$relative_path: the patch adds a module that a package now ships\n"
                if defined($entry->{source_path}) && -e $entry->{source_path};
            $patched{ $entry->{target_path} } = new_file_text($entry->{diff}, $relative_path);
        } else {
            $patched{ $entry->{target_path} } =
                apply_diff(read_file($entry->{source_path}), $entry->{diff}, $relative_path);
        }
    }
    return \%patched;
}

sub apparmor_paths {
    return map { $_->{target_path} }
        grep { $_->{kind} eq 'host' && index($_->{relative_path}, $APPARMOR_DIR) == 0 }
        read_file_diffs();
}

sub load_apparmor_profiles {
    return if !$system_mode;
    for my $path (apparmor_paths()) {
        system('apparmor_parser', '--replace', $path) == 0
            or die "pve-overlay: apparmor_parser --replace $path failed\n";
    }
}

sub unload_apparmor_profile {
    my ($path) = @_;
    return if !$system_mode;
    system('apparmor_parser', '--remove', $path) == 0
        or warn "pve-overlay: apparmor_parser --remove $path failed\n";
}

sub restart_units {
    return if !$system_mode;
    for my $unit (@UNITS) {
        system('systemctl', 'try-restart', "$unit.service") == 0
            or warn "pve-overlay: systemctl try-restart $unit.service failed\n";
    }
}

sub remove_copies {
    my $removed_count = 0;
    for my $entry (read_file_diffs()) {
        my $path = $entry->{target_path};
        next if !-e $path;
        unload_apparmor_profile($path)
            if $entry->{kind} eq 'host' && index($entry->{relative_path}, $APPARMOR_DIR) == 0;
        unlink($path) or die "cannot remove $path: $!\n";
        $removed_count++;
    }
    return $removed_count;
}

sub command_check {
    build_patched_files();
    print "every patch applies to the modules under $source_root$PACKAGED_MODULE_DIR\n";
}

sub command_apply {
    my $patched = eval { build_patched_files() };
    if (my $error = $@) {
        # A patched copy of an older module must not shadow a newer package.
        my $removed_count = remove_copies();
        restart_units() if $removed_count;
        die "pve-overlay: removed the patched copies, Proxmox runs packaged modules: $error";
    }

    my $changed_count = 0;
    for my $path (sort keys %$patched) {
        next if -e $path && read_file($path) eq $patched->{$path};
        write_file($path, $patched->{$path});
        print "wrote $path\n";
        $changed_count++;
    }

    if ($system_mode) {
        write_file($DPKG_HOOK_FILE, "post-invoke=" . abs_path($0) . " apply --hook\n");
    }
    # apparmor.service loads each profile file at boot. This call loads a new
    # or changed profile before the restarted units use it.
    load_apparmor_profiles() if $changed_count;
    restart_units() if $changed_count;
    print "the patched copies are current\n" if !$changed_count;
}

sub command_remove {
    my $removed_count = remove_copies();
    unlink($DPKG_HOOK_FILE) if $system_mode && -e $DPKG_HOOK_FILE;
    restart_units() if $removed_count;
    print "removed $removed_count patched copies\n";
}

sub command_status {
    my $patched = eval { build_patched_files() };
    if (my $error = $@) {
        print "drift: $error";
        return 1;
    }
    my $stale_count = 0;
    for my $path (sort keys %$patched) {
        my $state = 'missing';
        if (-e $path) {
            $state = read_file($path) eq $patched->{$path} ? 'current' : 'stale';
        }
        $stale_count++ if $state ne 'current';
        print "$state  $path\n";
    }
    return $stale_count ? 1 : 0;
}

# Loads each module in a taint-mode Perl process and confirms that Perl
# compiled the patched copy, not the packaged module.
sub command_compile {
    for my $module (grep { $_->{kind} eq 'module' } read_file_diffs()) {
        my $relative_path = $module->{relative_path};
        my $target_path = $module->{target_path};
        # Taint mode rejects a module path from the command line. The program
        # text includes the path instead.
        my $program = "require q{$relative_path}; print \$INC{q{$relative_path}}";
        my $loaded_path = qx{$^X -T -e '$program'};
        die "pve-overlay: $relative_path does not compile\n" if $? != 0;
        die "pve-overlay: Perl loaded $loaded_path instead of $target_path\n"
            if $loaded_path ne $target_path;
        print "compiled $target_path\n";
    }
}

# The drift check: writes the patched copies, then loads each one.
sub command_verify {
    command_apply();
    command_compile();
}

sub usage {
    die <<"USAGE";
usage: pve-overlay <command> [options]

  apply    write patched copies of the packaged modules to $DEFAULT_TARGET_DIR
  remove   delete the patched copies
  status   compare the patched copies with the packaged modules
  check    test that every patch applies, without writing files
  compile  load every patched copy in a taint-mode Perl process
  verify   run apply, then compile

  --source-root DIR  read packaged modules below DIR instead of /
  --target-dir DIR   write patched copies to DIR instead of $DEFAULT_TARGET_DIR
  --host-root DIR    write host files below DIR instead of /
  --no-system        skip the dpkg hook, the profile loads, and the service restarts
  --hook             dpkg hook mode: report a failure and exit 0
USAGE
}

my $command = shift(@ARGV) // usage();
GetOptions(
    'source-root=s' => \$source_root,
    'target-dir=s' => \$target_dir,
    'host-root=s' => \$host_root,
    'system!' => \$system_mode,
    'hook' => \$hook_mode,
) or usage();

my %commands = (
    apply => \&command_apply,
    remove => \&command_remove,
    status => \&command_status,
    check => \&command_check,
    compile => \&command_compile,
    verify => \&command_verify,
);
my $handler = $commands{$command} or usage();

if ($command eq 'status') {
    exit($handler->());
}
eval { $handler->() };
if (my $error = $@) {
    warn $error;
    # dpkg aborts the package operation when a hook exits nonzero.
    exit($hook_mode ? 0 : 1);
}
