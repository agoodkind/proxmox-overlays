+#!/bin/bash
+# This script replaces lxc-attach in tests. It runs the command after the double dash on
+# the test host.
+while [[ "$1" != "--" ]]; do
+    shift
+done
+shift
+exec "$@"
diff --git a/src/test/exec-worker-test.pl b/src/test/exec-worker-test.pl
new file mode 100755
index 0000000..84cf3e8
--- /dev/null
+++ b/src/test/exec-worker-test.pl
@@ -0,0 +1,222 @@
+#!/usr/bin/perl -T
+
+use strict;
+use warnings;
+
+use AnyEvent;
+use Cwd qw(abs_path);
+use Fcntl qw(O_CREAT O_EXCL O_WRONLY);
+use File::Path qw(make_path remove_tree);
+use File::Temp qw(tempdir);
+use MIME::Base64 qw(decode_base64 encode_base64);
+use POSIX;
+use Test::More;
+use Time::HiRes qw();
+
+use lib qw(..);
+use PVE::API2::LXC;
+use PVE::GuestExecResult;
+use PVE::ProcFSTools;
+use PVE::RPCEnvironment;
+
+# This command reads one byte and closes its input while it is still running.
+if (@ARGV == 1) {
+    my ($path) = $ARGV[0] =~ m!\A(/[\w/.-]+)\z! or die "invalid test output path\n";
+    sysread(STDIN, my $byte, 1) == 1 or die "unable to read test input: $!\n";
+    open(my $file, '>', $path) or die "unable to save the test PID: $!\n";
+    print {$file} "$$\n";
+    close($file) or die "unable to close the test PID file: $!\n";
+    close(STDIN);
+    sleep(3);
+    POSIX::_exit(0);
+}
+
+my $vmid = 290_000_000 + $$;
+my $directory = "/run/pve/lxc-exec/$vmid";
+die "test guest already has results\n" if -e $directory;
+my $test_pid = $$;
+END { remove_tree($directory) if defined($test_pid) && $$ == $test_pid && -d $directory; }
+
+my $bin = tempdir(CLEANUP => 1);
+($bin) = $bin =~ m!\A(/[\w/.-]+)\z! or die "invalid test directory\n";
+my ($attach) = abs_path('exec-fake-lxc-attach') =~ m!\A(/[\w/.-]+)\z!
+    or die "invalid test executable\n";
+symlink($attach, "$bin/lxc-attach") or die "unable to install test lxc-attach: $!\n";
+$ENV{PATH} = "$bin:/usr/sbin:/usr/bin:/sbin:/bin";
+delete @ENV{qw(IFS CDPATH ENV BASH_ENV)};
+
+# These checks run the command against the test host without requiring an LXC guest.
+my $starttime = \&PVE::ProcFSTools::read_proc_starttime;
+{
+    no warnings qw(once redefine);
+    *PVE::LXC::Config::load_config = sub { return {} };
+    *PVE::LXC::check_running = sub { return 1 };
+}
+AnyEvent::detect();
+make_path('/var/log/pve/tasks');
+my $rpcenv = PVE::RPCEnvironment->init('cli');
+$rpcenv->set_credentials({ userid => 'root@pam' });
+my $exec = PVE::API2::LXC->map_method_by_name('exec')->{code};
+my $status = PVE::API2::LXC->map_method_by_name('exec_status')->{code};
+my $write = PVE::API2::LXC->map_method_by_name('file_write')->{code};
+
+sub records {
+    return glob("$directory/[0-9]*");
+}
+
+sub wait_for {
+    my ($check) = @_;
+    my $deadline = Time::HiRes::time() + 12;
+    while (Time::HiRes::time() < $deadline) {
+        return 1 if $check->();
+        Time::HiRes::sleep(0.02);
+    }
+    return 0;
+}
+
+sub sigchld_blocked {
+    my $current = POSIX::SigSet->new();
+    POSIX::sigprocmask(POSIX::SIG_BLOCK(), POSIX::SigSet->new(), $current)
+        or die "unable to read the signal mask: $!\n";
+    return $current->ismember(POSIX::SIGCHLD());
+}
+
+my $original_mask = sigchld_blocked();
+
+subtest 'worker setup exits before the Proxmox startup handshake' => sub {
+    local $rpcenv->{atfork} = sub { POSIX::_exit(1) };
+    my @before = records();
+    eval { $exec->({ vmid => $vmid, command => ['true'] }); };
+    like($@, qr/got no worker upid/, 'exec returns the original fork_worker error');
+    is_deeply([records()], \@before, 'the failed call does not consume a result record');
+    is(sigchld_blocked(), $original_mask, 'exec restores the signal mask after failure');
+};
+
+subtest 'the worker exits before recording its identity' => sub {
+    my @before = records();
+    no warnings 'redefine';
+    local *PVE::ProcFSTools::read_proc_starttime = sub {
+        POSIX::_exit(1) if caller eq 'PVE::GuestExecResult';
+        return $starttime->(@_);
+    };
+    eval { $exec->({ vmid => $vmid, command => ['true'] }); };
+    like($@, qr/worker exited before reserving/, 'exec reports that the startup pipe closed');
+    is_deeply([records()], \@before, 'the interrupted worker did not allocate a record');
+};
+
+subtest 'the parent fails after releasing the worker' => sub {
+    my $started;
+    {
+        no warnings 'redefine';
+        local *PVE::RPCEnvironment::log_cluster_msg = sub { die "test cluster log failure\n" };
+        $started = eval { $exec->({ vmid => $vmid, command => ['true'] }) };
+        return
+            unless ok($started && $started->{pid}, 'exec returns the released worker identifier');
+    }
+    my $result;
+    ok(
+        wait_for(sub {
+            $result = $status->({ vmid => $vmid, pid => $started->{pid} });
+            return $result->{exited};
+        }),
+        'exec-status reports completion for the returned identifier',
+    );
+    is($result->{exitcode}, 0, 'the released command exits successfully');
+};
+
+subtest 'a storage error prevents execution' => sub {
+    my $blocked_vmid = $vmid + 1_000_000;
+    my $blocker = "/run/pve/lxc-exec/$blocked_vmid";
+    sysopen(my $handle, $blocker, O_CREAT | O_EXCL | O_WRONLY, 0600)
+        or die "unable to create the result storage fixture: $!\n";
+    close($handle);
+    eval { $exec->({ vmid => $blocked_vmid, command => ['mkdir', "$bin/ran"] }); };
+    my $error = $@;
+    unlink($blocker) or die "unable to remove the result storage fixture: $!\n";
+    like($error, qr/unable to read guest result storage/, 'exec returns the storage error');
+    ok(!-e "$bin/ran", 'the refused command did not run');
+};
+
+subtest 'CLI exec returns while the worker awaits input and preserves the live result' => sub {
+    my $age = time() - 3 * 3600;
+    my $gate = "$bin/input";
+    POSIX::mkfifo($gate, 0600) or die "unable to create test FIFO: $!\n";
+    my $id = $exec->({ vmid => $vmid, command => ['cat', $gate], timeout => 10 })->{pid};
+    my $pending = $status->({ vmid => $vmid, pid => $id });
+    return
+        unless is_deeply($pending, { exited => 0 },
+            'CLI exec returns before the command receives input');
+    is(sigchld_blocked(), $original_mask, 'exec restores the signal mask after success');
+    my $record = "$directory/$id";
+    ok(wait_for(sub { -f "$record/worker" }), 'the command worker records its identity');
+    utime($age, $age, $record) or die "unable to age the live reservation: $!\n";
+    my $result = eval { $status->({ vmid => $vmid, pid => $id }) };
+    is_deeply(
+        $result,
+        { exited => 0 },
+        'polling preserves a live reservation past the orphan TTL',
+    );
+    my $release;
+    PVE::Tools::run_with_timeout(
+        5,
+        sub {
+            open($release, '>', $gate) or die "unable to open the command FIFO: $!\n";
+        },
+    );
+    print {$release} 'complete';
+    close($release) or die "unable to release the command: $!\n";
+
+    if ($result) {
+        ok(wait_for(sub { -f "$record/status" }), 'the aged worker completes');
+        my $saved = $status->({ vmid => $vmid, pid => $id });
+        is(
+            decode_base64($saved->{'out-data'}),
+            'complete',
+            'polling returns the actual command output',
+        );
+    }
+
+    my $started = $starttime->($$) or die "unable to read test process start time\n";
+    for my $case (['reused PID', $started + 1], ['abandoned', undef]) {
+        my ($label, $stamp) = @$case;
+        my $stale = PVE::GuestExecResult::reserve('lxc', $vmid);
+        my $path = "$directory/$stale";
+        if (defined($stamp)) {
+            PVE::Tools::file_set_contents("$path/worker", "$$ $stamp", 0600);
+        }
+        utime($age, $age, $path) or die "unable to age an abandoned reservation: $!\n";
+        eval { $status->({ vmid => $vmid, pid => $stale }); };
+        like($@, qr/no stored result/, "$label expires after the orphan TTL");
+    }
+};
+
+subtest 'the command closes its input while data remains' => sub {
+    my $content = encode_base64('x' x (96 * 1024), '');
+    my $pidfile = "$bin/partial-reader";
+    my $result = $exec->({
+        vmid => $vmid,
+        command => ['/usr/bin/perl', '-T', abs_path($0), $pidfile],
+        'input-data' => $content,
+    });
+    my $id = $result->{pid};
+    ok(
+        wait_for(sub { return -e "$directory/$id/status" }),
+        'the worker reports a command outcome',
+    );
+    eval { $status->({ vmid => $vmid, pid => $id }); };
+    like($@, qr/writing command input.*Broken pipe/, 'exec-status rejects partial input');
+    my ($pid) = PVE::Tools::file_get_contents($pidfile) =~ m/\A(\d+)\n\z/;
+    ok(!-e "/proc/$pid", 'the worker reaps the command');
+
+    # The real true program exits successfully without reading the file-write request.
+    symlink('/usr/bin/true', "$bin/tee")
+        or die "unable to install the early exit fixture: $!\n";
+    eval { $write->({ vmid => $vmid, file => "$bin/output", content => $content }); };
+    like(
+        $@,
+        qr/writing command input.*Broken pipe/,
+        'file-write reports its failed input delivery',
+    );
+};
+
+done_testing();
