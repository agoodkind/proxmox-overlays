+    my $privileges = [];
+    for my $kind (@{ PVE::AccessControl::bpf_delegate_kinds() }) {
+        my $old_names = {};
+        for my $name (split(/;/, $old_delegate->{$kind} // '')) {
+            $old_names->{$name} = 1;
+        }
+        my $new_names = {};
+        for my $name (split(/;/, $new_delegate->{$kind} // '')) {
+            $new_names->{$name} = 1;
