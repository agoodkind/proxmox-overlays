+        chomp($err);
+        my $message = "bpfdelegate: $err\n";
+        print STDERR $message;
+        if (defined($vmid) && $vmid =~ m/^(\d+)\z/) {
+            my $warnings_file = "/run/pve/ct-$1.warnings";
+            if (open(my $fh, '>>', $warnings_file)) {
+                print {$fh} $message;
+                close($fh);
+            }
+        }
+        exit(1);
+    }
+}
