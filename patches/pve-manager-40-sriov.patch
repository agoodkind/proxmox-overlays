--- /dev/null
+++ b/overlay-root/usr/share/pve-overlay/sriov-restore
@@ -0,0 +1,8 @@
+#!/usr/bin/perl -T
+
+use strict;
+use warnings;
+use PVE::SRIOV;
+
+$ENV{PATH} = '/usr/sbin:/usr/bin:/sbin:/bin';
+PVE::SRIOV::restore();
diff --git a/test/Makefile b/test/Makefile
