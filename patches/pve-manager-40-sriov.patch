diff --git a/test/SRIOV_hardware_test.pl b/test/SRIOV_hardware_test.pl
new file mode 100644
index 00000000..74db6cba
--- /dev/null
+++ b/test/SRIOV_hardware_test.pl
@@ -0,0 +1,315 @@
+#!/usr/bin/perl
+
+use strict;
+use warnings;
+
+use JSON qw(decode_json);
+use POSIX qw(_exit);
+use Test::More;
+use PVE::API2::SRIOV;
+use PVE::File;
+use PVE::Tools qw(run_command);
+
+my $mode = shift // die "Specify unused, attached, mapped, or mixed.\n";
+my $port = shift // die "Specify the dedicated physical interface.\n";
+my $path = shift // die "Specify the JSON declaration file.\n";
+my $desired = decode_json(PVE::File::file_get_contents($path));
+my $json = JSON->new->canonical->allow_nonref;
+my $node = PVE::INotify::nodename();
+
+sub request {
+    my ($method, $body) = @_;
+    my $param = { node => $node, %{ $body // {} } };
+    my ($handler, $info) = PVE::API2::SRIOV->find_handler($method, $port, $param);
+    die "Cannot resolve $method for $port.\n" if !$handler;
+    return $handler->handle($info, $param, 1);
+}
+
+sub check_declared_vfs {
+    my ($state) = @_;
+    is($state->{numvfs}, $desired->{numvfs}, 'The PF reports the requested number of VFs');
+    for my $vf ($desired->{vfs}->@*) {
+        my $actual = $state->{vfs}->[$vf->{index}];
+        is($actual->{driver}, $vf->{driver}, "VF $vf->{index} binds to the declared driver");
+        is($actual->{mac}, lc($vf->{mac}), "VF $vf->{index} uses the declared MAC");
+        like(
+            $actual->{pci},
+            qr/\A[0-9a-f]{4}:[0-9a-f]{2}:[0-9a-f]{2}\.[0-7]\z/,
+            'GET reports the PCI address',
+        );
+        is($actual->{ifname}, $vf->{ifname}, 'The network driver uses the stable name')
+            if defined($vf->{ifname});
+    }
+}
+
+my $before = request('GET');
+if ($mode eq 'unused') {
+    die "This test requires a dedicated unmanaged adapter with zero enabled VFs.\n"
+        if $before->{numvfs} || exists($before->{desired});
+    die "Declare at least one VF and a positive VF count.\n"
+        if !@{ $desired->{vfs} } || !$desired->{numvfs};
+    my $reserve_id = shift // die "Specify an unused VMID for the pending PCI reservation test.\n";
+    die "The reservation test requires an unused VMID.\n"
+        if $reserve_id !~ /\A\d+\z/ || PVE::Cluster::get_vmlist()->{ids}->{$reserve_id};
+    my $isolated_node = shift // die "Specify the name of the isolated, guest-free test node.\n";
+    die "The isolated test node '$isolated_node' does not match '$node'.\n"
+        if $isolated_node ne $node;
+    my $check_isolation = sub {
+        my ($guests) = @_;
+        die "This restore test requires a node without guests.\n" if keys %$guests;
+        my $dir = '/etc/pve-overlay/sriov';
+        if (-d $dir) {
+            die "Direct restore would apply a declaration for another adapter.\n"
+                if grep { /\.json\z/ && $_ ne "$port.json" } PVE::SRIOV::entries($dir);
+        }
+    };
+    PVE::SRIOV::with_mutation_locks($check_isolation);
+    my $after = request('PUT', $desired);
+    is_deeply(request('GET'), $after, 'GET reads the enabled VFs and the saved declaration');
+    check_declared_vfs($after);
+    for my $vf ($after->{vfs}->@*) {
+        is(
+            $json->encode($vf->{in_container}),
+            'false',
+            "VF $vf->{index} reports false on the guest-free node",
+        );
+    }
+    is_deeply(request('PUT', $desired), $after, 'Repeated PUT preserves runtime and desired state');
+    my $pci = $after->{vfs}->[$desired->{vfs}->[0]->{index}]->{pci};
+    PVE::QemuServer::PCI::reserve_pci_usage($pci, $reserve_id, 30);
+    eval { request('DELETE') };
+    my $reserve_error = "$@";
+    PVE::QemuServer::PCI::remove_pci_reservation($reserve_id, [$pci]);
+    like(
+        $reserve_error,
+        qr/in use by VM \Q$reserve_id\E\b/,
+        'A PCI reservation protects the VF before QEMU publishes its PID',
+    );
+    PVE::SRIOV::with_mutation_locks(sub {
+        my ($guests) = @_;
+        $check_isolation->($guests);
+        my $saved = PVE::SRIOV::saved($port);
+        my ($state, $owners, $netns) = PVE::SRIOV::observe($port, $saved, $guests);
+        die "Runtime or desired state changed before the restoration test.\n"
+            if $json->encode($state) ne $json->encode($after);
+        PVE::SRIOV::apply_port(
+            $port,
+            $state,
+            $owners,
+            { numvfs => 0, vfs => [] },
+            $guests,
+            $netns,
+        );
+    });
+    my $cleared = request('GET');
+    is_deeply(
+        $cleared,
+        { %$after, numvfs => 0, vfs => [] },
+        'The kernel removed all VFs and the original declaration remains on disk',
+    ) or BAIL_OUT('Cannot verify reconstruction without cleared runtime state');
+    run_command(['/usr/bin/perl', '-T', '/usr/share/pve-overlay/sriov-restore']);
+    my $restored = request('GET');
+    is_deeply(
+        $restored->{desired},
+        $after->{desired},
+        'The restore program preserves the saved declaration',
+    );
+    check_declared_vfs($restored);
+    for my $vf ($desired->{vfs}->@*) {
+        my $index = $vf->{index};
+        is(
+            $restored->{vfs}->[$index]->{pci},
+            $after->{vfs}->[$index]->{pci},
+            "Restore recreates VF $index at its PCI address",
+        );
+    }
+    request('DELETE');
+    is_deeply(request('GET'), $before, 'DELETE restores the unused adapter');
+} elsif ($mode eq 'attached') {
+    my $index = shift // die "Specify the VF index in use by a running guest.\n";
+    my $vmid = shift // die "Specify the running guest ID.\n";
+    my $guest_name = shift;
+    die "Specify the currently applied declaration for the attached adapter.\n"
+        if $json->encode($desired) ne $json->encode($before->{desired});
+    my ($vf) = grep { $_->{index} == $index } $desired->{vfs}->@*;
+    die "Declare the in-use VF index $index.\n" if !$vf;
+    if ($vf->{driver} ne 'vfio-pci') {
+        die "Specify the interface name in the running container.\n" if !defined($guest_name);
+        is(
+            $before->{vfs}->[$index]->{ifname},
+            $guest_name,
+            'GET locates the moved VF in the container',
+        );
+        is(
+            $json->encode($before->{vfs}->[$index]->{in_container}),
+            'true',
+            'GET reports a VF in the container namespace',
+        );
+    } else {
+        is(
+            $json->encode($before->{vfs}->[$index]->{in_container}),
+            'false',
+            'GET reports false for a VM passthrough VF',
+        );
+    }
+    is_deeply(request('PUT', $desired), $before, 'A running guest permits an identical PUT');
+    my $class = $vf->{driver} eq 'vfio-pci' ? 'PVE::QemuConfig' : 'PVE::LXC::Config';
+    $class->lock_config(
+        $vmid,
+        sub {
+            pipe(my $reader, my $writer) or die "Cannot create the lock test pipe: $!\n";
+            my $pid = fork() // die "Cannot fork the concurrent API request: $!\n";
+            if (!$pid) {
+                close($reader);
+                eval { request('PUT', $desired) };
+                print {$writer} "$@";
+                close($writer);
+                _exit(0);
+            }
+            close($writer);
+            my $error = do { local $/; <$reader> };
+            close($reader);
+            waitpid($pid, 0);
+            is($?, 0, 'The concurrent API request finished');
+            like(
+                $error,
+                qr/can't lock file.*\Q$vmid\E.*(?:timed out|timeout)/is,
+                'PUT honors the configuration lock used by guest startup',
+            );
+        },
+    );
+    my $owner = qr/in use by (?:VM|container) \Q$vmid\E\b/;
+    for my $change (
+        sub { $_[0]->{numvfs} = 0; $_[0]->{vfs} = [] },
+        sub {
+            $_[1]->{mac} =
+                $_[1]->{mac} eq '02:ff:ff:ff:ff:fe' ? '02:ff:ff:ff:ff:fd' : '02:ff:ff:ff:ff:fe';
+        },
+        sub {
+            delete $_[1]->{ifname};
+            $_[1]->{driver} = $_[1]->{driver} eq 'vfio-pci' ? 'iavf' : 'vfio-pci';
+        },
+        (
+            $vf->{driver} eq 'vfio-pci' ? () : sub {
+                $_[1]->{ifname} =
+                    $_[1]->{ifname} eq 'sriov-check' ? 'sriov-test' : 'sriov-check';
+            }
+        ),
+    ) {
+        my $changed = decode_json($json->encode($desired));
+        my ($entry) = grep { $_->{index} == $index } $changed->{vfs}->@*;
+        $change->($changed, $entry);
+        eval { request('PUT', $changed) };
+        like("$@", $owner, 'A running guest prevents a conflicting declaration');
+    }
+    eval { request('DELETE') };
+    like("$@", $owner, 'A running guest prevents DELETE');
+    is_deeply(request('GET'), $before, 'Rejected changes preserve runtime and desired state');
+} elsif ($mode eq 'mapped') {
+    my ($vmid, $key, $selected, $spare, $test_mac) = @ARGV;
+    die "Specify the VMID, hostpci property, selected index, spare index, and spare test MAC.\n"
+        if !defined($test_mac)
+        || $vmid !~ /\A\d+\z/
+        || $key !~ /\Ahostpci\d+\z/
+        || $selected !~ /\A\d+\z/
+        || $spare !~ /\A\d+\z/
+        || $selected == $spare;
+    die "The test requires a running VM and its current declaration.\n"
+        if !PVE::QemuServer::check_running($vmid, 1)
+        || $json->encode($desired) ne $json->encode($before->{desired});
+    my $value = PVE::QemuConfig->load_config($vmid)->{$key} // die "Missing $key on VM $vmid.\n";
+    my $device = PVE::QemuServer::PCI::parse_hostpci($value);
+    my %choices = map { @$_ == 1 ? ($_->[0]->{id} => 1) : () } $device->{ids}->@*;
+    my $selected_pci = $before->{vfs}->[$selected]->{pci} // die "Missing selected VF.\n";
+    my $spare_pci = $before->{vfs}->[$spare]->{pci} // die "Missing spare VF.\n";
+    die "Both VFs must be distinct alternatives of $key.\n"
+        if !$choices{$selected_pci} || !$choices{$spare_pci};
+    my $owners = PVE::QemuServer::PCI::get_reservation_owners();
+    die "QEMU must own the selected VF and leave the spare unreserved.\n"
+        if ($owners->{$selected_pci} // -1) != $vmid || exists($owners->{$spare_pci});
+    die "Choose a fresh test MAC outside the current declaration.\n"
+        if grep { lc($_->{mac}) eq lc($test_mac) } $desired->{vfs}->@*;
+    my $changed_mac = sub {
+        my ($index) = @_;
+        my $changed = decode_json($json->encode($desired));
+        my ($vf) = grep { $_->{index} == $index } $changed->{vfs}->@*;
+        die "VF $index must have a declaration.\n" if !$vf;
+        $vf->{mac} = $test_mac;
+        return $changed;
+    };
+    my $active_change = $changed_mac->($selected);
+    my $spare_change = $changed_mac->($spare);
+    eval { request('PUT', $active_change) };
+    like("$@", qr/in use by VM \Q$vmid\E\b/, 'PUT rejects a change to the selected mapping');
+    eval {
+        request('PUT', $spare_change);
+        my $actual = request('GET');
+        is(
+            $actual->{vfs}->[$spare]->{mac},
+            lc($test_mac),
+            'PUT changes the unused mapping alternative',
+        );
+        is_deeply(
+            $actual->{vfs}->[$selected],
+            $before->{vfs}->[$selected],
+            'The selected VF retains its settings',
+        );
+    };
+    my $error = $@;
+    request('PUT', $desired);
+    die $error if $error;
+    is_deeply(request('GET'), $before, 'The spare VF returns to its original configuration');
+} elsif ($mode eq 'mixed') {
+    my ($host_index, $moved_index, $shared_id, $private_id, $guest_name) = @ARGV;
+    die
+        "Specify the host VF index, moved VF index, shared-namespace CT ID, private-namespace CT ID, and guest interface.\n"
+        if !defined($guest_name)
+        || grep { !defined($_) || $_ !~ /\A\d+\z/ }
+        ($host_index, $moved_index, $shared_id, $private_id);
+    die "Use distinct VF indices and a lower CT ID for the shared namespace.\n"
+        if $host_index == $moved_index || $shared_id >= $private_id;
+    my $pf = PVE::SRIOV::pf_device($port);
+    my @host_names = PVE::SRIOV::entries("$pf/virtfn$host_index/net");
+    die "The host VF must expose exactly one network interface.\n" if @host_names != 1;
+    my $shared_pid = PVE::LXC::find_lxc_pid($shared_id);
+    my $private_pid = PVE::LXC::find_lxc_pid($private_id);
+    my $net_id =
+        sub { readlink("/proc/$_[0]/ns/net") // die "Cannot inspect the namespace of $_[0]: $!\n" };
+    my $host_ns = $net_id->('self');
+    die "The first CT must share the host network namespace.\n"
+        if $net_id->($shared_pid) ne $host_ns;
+    die "The second CT must use its own network namespace.\n"
+        if $net_id->($private_pid) eq $host_ns;
+    my $info = PVE::SRIOV::output([
+        '/usr/bin/nsenter',
+        '--target',
+        $private_pid,
+        '--net',
+        '--',
+        '/sbin/ethtool',
+        '-i',
+        PVE::SRIOV::port_name($guest_name),
+    ]);
+    my $pci = $before->{vfs}->[$moved_index]->{pci};
+    die "The specified container interface must use the moved VF.\n"
+        if !defined($pci) || $info !~ /^bus-info:\s*\Q$pci\E$/m;
+    is(
+        $before->{vfs}->[$host_index]->{ifname},
+        $host_names[0],
+        'GET reports the host-visible VF name',
+    );
+    is(
+        $json->encode($before->{vfs}->[$host_index]->{in_container}),
+        'false',
+        'GET excludes the shared namespace',
+    );
+    is($before->{vfs}->[$moved_index]->{ifname}, $guest_name, 'GET reports the moved VF name');
+    is(
+        $json->encode($before->{vfs}->[$moved_index]->{in_container}),
+        'true',
+        'GET identifies the VF in the private namespace',
+    );
+} else {
+    die "Specify unused, attached, mapped, or mixed.\n";
+}
+done_testing();
diff --git a/test/SRIOV_namespace_test.pl b/test/SRIOV_namespace_test.pl
new file mode 100644
index 00000000..085cda7c
--- /dev/null
+++ b/test/SRIOV_namespace_test.pl
@@ -0,0 +1,48 @@
+#!/usr/bin/perl
+
+use strict;
+use warnings;
+
+use IPC::Open2;
+use Test::More;
+use PVE::SRIOV;
+
+$ENV{PATH} = '/usr/sbin:/usr/bin:/sbin:/bin';
+for my $shared (1, 0) {
+    my @command = $shared ? ('/bin/cat') : ('/usr/bin/unshare', '--net', '--', '/bin/cat');
+    my $pid = open2(my $output, my $input, @command);
+    print {$input} "ready\n";
+    my $ready = <$output>;
+    die "The network namespace test process did not start.\n" if !defined($ready);
+    my $identity = readlink("/proc/$pid/ns/net")
+        // die "Cannot read the test namespace for PID $pid: $!\n";
+    my $namespace = PVE::SRIOV::open_container_netns($pid);
+    close($input);
+    waitpid($pid, 0);
+    die "The network namespace test process exited with status $?.\n" if $?;
+
+    if ($shared) {
+        ok(
+            !defined($namespace),
+            'The scanner skips a second process sharing the host network namespace',
+        );
+    } else {
+        ok(defined($namespace), 'The scanner opens a separate Linux network namespace');
+        my $actual = PVE::SRIOV::output([
+            PVE::SRIOV::enter_netns($namespace), '/usr/bin/readlink', '/proc/self/ns/net',
+        ]);
+        chomp $actual;
+        is(
+            $actual,
+            $identity,
+            'nsenter uses the verified namespace even after the original process exits',
+        );
+    }
+    eval { PVE::SRIOV::open_container_netns($pid) };
+    like(
+        "$@",
+        qr{Cannot open the network namespace at \Q/proc/$pid/ns/net\E:},
+        'An unavailable namespace reports its path',
+    );
+}
+done_testing();
diff --git a/test/SRIOV_reservation_test.pl b/test/SRIOV_reservation_test.pl
new file mode 100644
index 00000000..da4d0d73
--- /dev/null
+++ b/test/SRIOV_reservation_test.pl
@@ -0,0 +1,87 @@
+#!/usr/bin/perl
+
+use strict;
+use warnings;
+
+use POSIX qw(WNOHANG _exit);
+use Test::More;
+use PVE::QemuServer::PCI;
+use PVE::QemuServer::Helpers;
+
+my ($address, $vmid, $other) = @ARGV;
+die "Specify a PCI address and two unused VMIDs on an isolated test node.\n"
+    if !defined($other)
+    || $vmid !~ /\A\d+\z/
+    || $other !~ /\A\d+\z/
+    || $vmid == $other
+    || $address !~ /\A[0-9a-f]{4}:[0-9a-f]{2}:[0-9a-f]{2}\.[0-7]\z/;
+die "Missing PCI device $address.\n" if !-e "/sys/bus/pci/devices/$address";
+
+for my $id ($vmid, $other) {
+    my @configs =
+        (glob("/etc/pve/nodes/*/qemu-server/$id.conf"), glob("/etc/pve/nodes/*/lxc/$id.conf"));
+    die "VMID $id is already in use.\n"
+        if @configs || -e PVE::QemuServer::Helpers::vm_pidfile_name($id);
+}
+my $owners = sub { PVE::QemuServer::PCI::get_reservation_owners()->{$address} };
+die "PCI device $address is reserved.\n" if defined($owners->());
+my $child;
+eval {
+    PVE::QemuServer::PCI::reserve_pci_usage($address, $vmid, 0);
+    is($owners->(), $vmid, 'A pending reservation protects the device before PID publication');
+    eval { PVE::QemuServer::PCI::reserve_pci_usage($address, $other, 0) };
+    like("$@", qr/currently reserved/,
+        'QEMU rejects another VM during the pending reservation');
+    for (1 .. 70) {
+        last if !defined($owners->());
+        select(undef, undef, undef, 0.1);
+    }
+    is($owners->(), undef, 'An expired deadline releases ownership without manual cleanup');
+    PVE::QemuServer::PCI::reserve_pci_usage($address, $other, 0);
+    is($owners->(), $other, 'Another VM can reuse the expired reservation');
+
+    my $pidfile = PVE::QemuServer::Helpers::vm_pidfile_name($other);
+    $child = fork() // die "Cannot start QEMU: $!\n";
+    if (!$child) {
+        exec(
+            '/usr/bin/kvm',
+            '-machine',
+            'none,accel=tcg',
+            '-nodefaults',
+            '-display',
+            'none',
+            '-S',
+            '-pidfile',
+            $pidfile,
+        ) or _exit(127);
+    }
+    my $running_pid;
+    for (1 .. 100) {
+        $running_pid = PVE::QemuServer::Helpers::vm_running_locally($other);
+        last if defined($running_pid);
+        if (waitpid($child, WNOHANG) == $child) {
+            undef $child;
+            die "The test QEMU process exited during startup: $?.\n";
+        }
+        select(undef, undef, undef, 0.1);
+    }
+    die "Proxmox could not identify the test QEMU process.\n" if !defined($running_pid);
+    PVE::QemuServer::PCI::reserve_pci_usage($address, $other, undef, $running_pid);
+    is($owners->(), $other, 'A running VM owns its PID reservation');
+    eval { PVE::QemuServer::PCI::reserve_pci_usage($address, $vmid, 0) };
+    like("$@", qr/already in use/, 'QEMU rejects another VM while the owner is running');
+    kill('TERM', $child) or die "Cannot stop the test QEMU process: $!\n";
+    waitpid($child, 0);
+    undef $child;
+    is($owners->(), undef, 'The exited VM releases ownership without manual cleanup');
+    PVE::QemuServer::PCI::reserve_pci_usage($address, $vmid, 0);
+    is($owners->(), $vmid, 'Another VM can reuse the exited owner reservation');
+};
+my $error = $@;
+if ($child) {
+    kill('TERM', $child);
+    waitpid($child, 0);
+}
+PVE::QemuServer::PCI::remove_pci_reservation($_, [$address]) for ($vmid, $other);
+die $error if $error;
+done_testing();
diff --git a/test/SRIOV_start_test.pl b/test/SRIOV_start_test.pl
new file mode 100644
index 00000000..e6db16db
--- /dev/null
+++ b/test/SRIOV_start_test.pl
@@ -0,0 +1,87 @@
+#!/usr/bin/perl
+
+use strict;
+use warnings;
+
+use POSIX qw(_exit);
+use Time::HiRes qw(sleep time);
+use Test::More;
+use PVE::File;
+use PVE::SRIOV;
+use PVE::QemuConfig;
+use PVE::QemuServer;
+use PVE::RPCEnvironment;
+use PVE::Storage;
+
+my $id = shift // die "Specify an unused VMID on a disposable Proxmox node.\n";
+my $rpc = PVE::RPCEnvironment->init('cli');
+$rpc->set_user('root@pam');
+if (@ARGV && $ARGV[0] eq '--start') {
+    PVE::QemuServer::vm_start(PVE::Storage::config(), $id, {}, {});
+    exit(0);
+}
+my $pci = 'ffff:ff:1f.7';
+die "The test PCI address exists on this node.\n" if -e "/sys/bus/pci/devices/$pci";
+my ($created, $child, $output);
+
+eval {
+    PVE::SRIOV::with_mutation_locks(sub {
+        my ($inventory) = @_;
+        die "The test VMID $id already exists.\n" if $inventory->{$id};
+        PVE::QemuConfig->create_and_lock_config($id);
+        $created = 1;
+        PVE::QemuConfig->lock_config(
+            $id,
+            sub {
+                PVE::QemuConfig->write_config(
+                    $id,
+                    {
+                        name => 'sriov-lock-test',
+                        memory => 128,
+                        kvm => 0,
+                        hostpci0 => $pci,
+                    },
+                );
+            },
+        );
+        pipe($output, my $writer) or die "Cannot create the startup result pipe: $!\n";
+        $child = fork() // die "Cannot fork qm start: $!\n";
+        if (!$child) {
+            close($output);
+            open(STDOUT, '>&', $writer) or _exit(126);
+            open(STDERR, '>&', $writer) or _exit(126);
+            exec($^X, $0, $id, '--start') or _exit(127);
+        }
+        close($writer);
+        my $inode = (stat(PVE::SRIOVLock::PATH))[1] // die "Cannot inspect the node lock: $!\n";
+        my $until = time() + 30;
+        while (time() < $until) {
+            my $locks = PVE::File::file_get_contents('/proc/locks');
+            if ($locks =~ /^\d+: -> FLOCK\s+ADVISORY\s+READ\s+(\d+)\s+\S+:$inode\s/m) {
+                my $command = PVE::File::file_get_contents("/proc/$1/cmdline");
+                if (index($command, "$id") >= 0) {
+                    pass('The new VMID waits for the active SR-IOV mutation at startup');
+                    return;
+                }
+            }
+            sleep(0.05);
+        }
+        die "VM startup did not wait on the exclusive attachment lock.\n";
+    });
+};
+my $error = $@;
+if ($child) {
+    my $message = do { local $/; <$output> };
+    close($output);
+    waitpid($child, 0);
+    isnt($?, 0, 'Startup rejects the nonexistent PCI device after the mutation finishes');
+    like(
+        $message,
+        qr/no PCI device found for '\Q$pci\E'/,
+        'QEMU resolves the PCI ID after acquiring the shared lock',
+    );
+    diag($message) if $error;
+}
+PVE::QemuConfig->lock_config($id, sub { PVE::QemuConfig->destroy_config($id) }) if $created;
+die $error if $error;
+done_testing();
diff --git a/test/SRIOV_test.pl b/test/SRIOV_test.pl
new file mode 100644
index 00000000..e3fd96af
--- /dev/null
+++ b/test/SRIOV_test.pl
@@ -0,0 +1,125 @@
+#!/usr/bin/perl
+
+use strict;
+use warnings;
+
+use Fcntl qw(:flock);
+use IO::Select;
+use POSIX qw(_exit);
+use Test::More;
+use PVE::API2::SRIOV;
+
+sub request {
+    my ($method, $ifname, $body) = @_;
+    my $param = { node => 'localhost', %{ $body // {} } };
+    my ($handler, $info) = PVE::API2::SRIOV->find_handler($method, $ifname, $param);
+    die "$method $ifname did not resolve to a Proxmox API handler.\n" if !$handler;
+    return $handler->handle($info, $param, 1);
+}
+
+for my $method (qw(GET PUT)) {
+    my (undef, $info) = PVE::API2::SRIOV->find_handler($method, 'lo', { node => 'localhost' });
+    my $field = $info->{returns}->{properties}->{vfs}->{items}->{properties}->{in_container};
+    is(
+        $field->{type},
+        'boolean',
+        "$method exposes a Boolean container location for each runtime VF",
+    );
+    ok(!$field->{optional}, "$method requires the container location in the response");
+}
+
+for my $method (qw(GET PUT DELETE)) {
+    my $body = $method eq 'PUT' ? { numvfs => 1, vfs => [] } : {};
+    eval { request($method, 'lo', $body) };
+    like("$@", qr/does not support SR-IOV/, "$method rejects the loopback interface");
+    eval { request($method, 'absent-sriov-pf', $body) };
+    like("$@", qr/does not exist/, "$method rejects a missing adapter");
+}
+
+eval { request('PUT', 'lo', { numvfs => 1, vfs => [{ index => 0, mac => '02:00:00:00:00:01' }] }) };
+like("$@", qr/driver/, 'PUT requires a driver for each declared VF');
+eval {
+    request(
+        'PUT',
+        'lo',
+        { numvfs => 1, vfs => [{ index => 0, mac => 'invalid', driver => 'iavf' }] },
+    );
+};
+like("$@", qr/mac/, 'PUT rejects an invalid VF MAC address');
+eval {
+    request(
+        'PUT',
+        'lo',
+        {
+            numvfs => 1,
+            vfs => [{ index => 0, mac => '02:00:00:00:00:01', driver => 'iavf', vmid => 100 }],
+        },
+    );
+};
+like("$@", qr/vmid/, 'PUT rejects a guest attachment field');
+eval {
+    request(
+        'PUT',
+        'lo',
+        {
+            numvfs => 1,
+            vfs =>
+                [{ index => 0, mac => '02:00:00:00:00:01', driver => 'iavf', in_container => 1 }],
+        },
+    );
+};
+like("$@", qr/in_container/, 'PUT rejects the computed container location in a declaration');
+for my $case (
+    ['QEMU', \&PVE::QemuServer::PCI::lock_hostpci_for_start, { hostpci0 => 'mapping=test-vf' }],
+    ['LXC', \&PVE::LXC::lock_hostnics_for_start, { hostnic0 => 'link=test-vf' }],
+) {
+    my ($label, $attach, $config) = @$case;
+    open(my $writer_lock, '>>', PVE::SRIOVLock::PATH) or die "Cannot open the node lock: $!\n";
+    flock($writer_lock, LOCK_EX) or die "Cannot acquire the node lock: $!\n";
+    ok(!defined($attach->({})), "$label skips the node lock for a guest without physical devices");
+
+    pipe(my $events, my $child_output) or die "Cannot create the attachment pipe: $!\n";
+    pipe(my $release, my $continue) or die "Cannot create the release pipe: $!\n";
+    my $pid = fork() // die "Cannot fork the attachment process: $!\n";
+    if (!$pid) {
+        close($writer_lock);
+        close($events);
+        close($continue);
+        $child_output->autoflush(1);
+        print {$child_output} "starting\n";
+        my $reader = $attach->($config);
+        print {$child_output} "attached\n";
+        scalar(<$release>);
+        _exit(defined($reader) ? 0 : 1);
+    }
+    close($child_output);
+    close($release);
+    is(scalar(<$events>), "starting\n", "$label starts a new guest during a mutation");
+    my $ready = IO::Select->new($events);
+    ok(!$ready->can_read(0.25), "$label waits for the exclusive mutation to finish");
+    close($writer_lock);
+    ok($ready->can_read(5), "$label resumes after mutation");
+    is(scalar(<$events>), "attached\n", "$label acquired the shared attachment lock");
+    open(my $probe, '>>', PVE::SRIOVLock::PATH) or die "Cannot open the lock probe: $!\n";
+    ok(!flock($probe, LOCK_EX | LOCK_NB), "$label excludes a mutation during attach");
+    ok(flock($probe, LOCK_SH | LOCK_NB), "$label allows another guest to attach concurrently");
+    close($probe);
+    close($continue);
+    close($events);
+    waitpid($pid, 0);
+    is($?, 0, "$label releases the lock after attach");
+}
+my $missing_link = 'absent-sriov-pf';
+eval { PVE::LXC::vm_start(299999999, { hostnic0 => "link=$missing_link" }) };
+like(
+    "$@",
+    qr/Host interface '\Q$missing_link\E' does not exist/,
+    'LXC startup fails at the physical interface check',
+);
+open(my $after_failure, '>>', PVE::SRIOVLock::PATH) or die "Cannot inspect the node lock: $!\n";
+ok(
+    flock($after_failure, LOCK_EX | LOCK_NB),
+    'LXC releases the shared lock after startup rejects the device',
+);
+close($after_failure);
+done_testing();
