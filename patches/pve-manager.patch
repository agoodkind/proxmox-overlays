+[Unit]
+Description=Declare the SR-IOV virtual functions of %I
+After=network-pre.target
+Wants=network-pre.target
+Before=pve-guests.service
+
+[Service]
+Type=oneshot
+RemainAfterExit=yes
+ExecStart=/usr/bin/perl -T /usr/share/pve-overlay/sriov-apply %i
+
+[Install]
+WantedBy=multi-user.target
diff --git a/overlay-root/usr/share/pve-overlay/sriov-apply b/overlay-root/usr/share/pve-overlay/sriov-apply
new file mode 100755
index 00000000..65861b9c
--- /dev/null
+++ b/overlay-root/usr/share/pve-overlay/sriov-apply
@@ -0,0 +1,13 @@
+#!/usr/bin/perl -T
+
+use strict;
+use warnings;
+
+use PVE::API2::SRIOV;
+
+$ENV{PATH} = '/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin';
+delete @ENV{qw(IFS CDPATH ENV BASH_ENV)};
+
+die "usage: sriov-apply <ifname>\n" if scalar(@ARGV) != 1;
+
+PVE::API2::SRIOV->apply_saved($ARGV[0]);
