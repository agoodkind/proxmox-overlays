+    my $pid = fork() // die "cannot fork: $!\n";
+    if (!$pid) {
+        open(STDOUT, '>', '/dev/null') or POSIX::_exit(2);
+        eval { install_archive($lock_policy, $archive) };
+        POSIX::_exit($@ ? 1 : 0);
+    }
+    push @installers, $pid;
+}
+my @exit_codes;
