+++ b/src/test/hostnic-monitor-storage-test.pl
@@ -0,0 +1,54 @@
+#!/usr/bin/perl
+
+use strict;
+use warnings;
+
+use Test::More;
+use PVE::LXC;
+use PVE::LXC::Config;
+use PVE::LXC::Monitor;
+use PVE::Storage;
+
+# Run on a disposable node with lxc-monitord stopped. The guest must have a
+# hostnic and a missing rootfs file on an existing directory storage.
+my $vmid = shift // die "Specify a disposable container VMID.\n";
+die "Specify a numeric VMID.\n" if $vmid !~ /\A\d+\z/;
+die "The LXC monitor is running.\n" if eval { PVE::LXC::Monitor::get_monitor_socket() };
+
+PVE::LXC::Config->lock_config(
+    $vmid,
+    sub {
+        my $conf = PVE::LXC::Config->load_config($vmid);
+        die "The test container is running.\n" if PVE::LXC::check_running($vmid);
+        my $hostnics = PVE::LXC::Config->get_hostnics($conf);
+        die "The test requires a hostnic device.\n" if !keys %$hostnics;
+        my $mount = PVE::LXC::Config->parse_volume('rootfs', $conf->{rootfs});
+        my $volume = $mount->{volume};
+        my ($storeid) = PVE::Storage::parse_volume_id($volume);
+        my $storecfg = PVE::Storage::config();
+        my $storage = PVE::Storage::storage_config($storecfg, $storeid);
+        die "The test requires an existing directory storage.\n"
+            if $storage->{type} ne 'dir' || !-d $storage->{path};
+        die "The test rootfs file must be missing.\n"
+            if -e PVE::Storage::path($storecfg, $volume);
+        die "The skiplock flag already exists.\n" if -e "/run/lxc/skiplock-$vmid";
+
+        my %ordinary = %$conf;
+        delete @ordinary{ keys %$hostnics };
+        eval { PVE::LXC::vm_start($vmid, \%ordinary) };
+        like(
+            $@,
+            qr/volume '\Q$volume\E' does not exist/,
+            'Without hostnic, startup continues to the real storage activation error',
+        );
+
+        eval { PVE::LXC::vm_start($vmid, $conf, 1) };
+        like(
+            $@,
+            qr/Cannot monitor startup for container $vmid: failed to connect/,
+            'With hostnic, startup rejects the missing monitor before storage activation',
+        );
+        ok(!-e "/run/lxc/skiplock-$vmid", 'The rejected start does not leave a skiplock flag');
+    },
+);
+done_testing();
diff --git a/src/test/hostnic-slow-start-test.pl b/src/test/hostnic-slow-start-test.pl
new file mode 100644
index 0000000..c196d8d
--- /dev/null
+++ b/src/test/hostnic-slow-start-test.pl
@@ -0,0 +1,105 @@
+#!/usr/bin/perl
+
+use strict;
+use warnings;
+
+use Errno qw(EWOULDBLOCK);
+use Fcntl qw(:flock);
+use POSIX qw(_exit);
+use Test::More;
+use PVE::LXC;
+use PVE::LXC::Config;
+use PVE::LXC::Monitor;
+use PVE::RPCEnvironment;
+use PVE::SRIOVLock;
+use PVE::Tools qw(run_command);
+
+# Run on a disposable node with a stopped hostnic guest. Its liblxc pre-start
+# hook must take at least 70 seconds and then either succeed or reject startup.
+my ($vmid, $expected) = @ARGV;
+die "Specify a disposable container VMID and either running or aborted.\n"
+    if !defined($vmid) || $vmid !~ /^\d+$/ || ($expected // '') !~ /\A(?:running|aborted)\z/;
+
+my $rpcenv = PVE::RPCEnvironment->init('cli');
+$rpcenv->set_user('root@pam');
+my $config = PVE::LXC::Config->load_config($vmid);
+die "The test requires a hostnic device.\n" if !keys(PVE::LXC::Config->get_hostnics($config)->%*);
+die "Container $vmid is already running.\n" if PVE::LXC::check_running($vmid);
+my $monitor = PVE::LXC::Monitor::get_monitor_socket();
+pipe(my $reader, my $writer) or die "Cannot create the startup result pipe: $!\n";
+my $child = fork() // die "Cannot start the test worker: $!\n";
+
+if (!$child) {
+    close($reader);
+    close($monitor);
+    eval {
+        PVE::LXC::Config->lock_config(
+            $vmid,
+            sub {
+                my $conf = PVE::LXC::Config->load_config($vmid);
+                PVE::LXC::vm_start($vmid, $conf, undef, 0);
+            },
+        );
+    };
+    my $err = $@;
+    print {$writer} $err;
+    close($writer) or _exit(2);
+    _exit($err ? 1 : 0);
+}
+close($writer);
+
+eval {
+    PVE::Tools::run_with_timeout(
+        30,
+        sub {
+            while (1) {
+                my ($type, $name, $state) = PVE::LXC::Monitor::read_lxc_message($monitor);
+                die "The LXC monitor closed before STARTING.\n" if !defined($type);
+                last
+                    if $type eq 'STATE'
+                    && $name eq "$vmid"
+                    && $state == PVE::LXC::Monitor::STATE_STARTING;
+            }
+        },
+    );
+    sleep(63);
+    open(my $lock, '>>', PVE::SRIOVLock::PATH) or die "Cannot open the attachment lock: $!\n";
+    my $available = flock($lock, LOCK_EX | LOCK_NB);
+    my $busy = !$available && $! == EWOULDBLOCK;
+    close($lock);
+    ok($busy, 'The physical attachment still excludes mutation 63 seconds after STARTING');
+};
+my $monitor_error = $@;
+my $error = do { local $/; <$reader> };
+waitpid($child, 0) == $child or die "Cannot wait for the test worker: $!\n";
+my $status = $?;
+open(my $lock, '>>', PVE::SRIOVLock::PATH) or die "Cannot reopen the attachment lock: $!\n";
+ok(flock($lock, LOCK_EX | LOCK_NB), 'Mutation can acquire the lock after startup finishes');
+close($lock);
+my $unit = "pve-container\@$vmid.service";
+my $unit_state = sub {
+    my $state;
+    run_command(
+        ['systemctl', 'show', $unit, '-p', 'ActiveState', '--value'],
+        outfunc => sub { $state = shift },
+    );
+    return $state;
+};
+if ($expected eq 'running') {
+    is($status, 0, 'The slow startup succeeds') or diag($error);
+    ok(eval { PVE::LXC::find_lxc_pid($vmid) }, 'The running container has an init PID');
+} else {
+    is($status, 256, 'The rejected startup fails');
+    like(
+        $error,
+        qr/startup for container '\Q$vmid\E' failed/,
+        'The monitor reports the terminal state',
+    );
+    like($unit_state->(), qr/\A(?:failed|inactive)\z/, 'The systemd unit has stopped');
+    ok(!PVE::LXC::check_running($vmid), 'Teardown finishes before vm_start returns');
+}
+run_command(['systemctl', 'stop', $unit]);
+like($unit_state->(), qr/\A(?:failed|inactive)\z/, 'Cleanup stopped the test unit');
+ok(!PVE::LXC::check_running($vmid), 'Cleanup stopped the test container');
+die $monitor_error if $monitor_error;
+done_testing();
